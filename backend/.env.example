# Database (SQLite by default; swap to a PostgreSQL URL for production)
DATABASE_URL=sqlite:///./data/outdoor_hounds.db

# LLM controls — defaults keep the app free and deterministic (mock mode)
LLM_ENABLED=false
LLM_PROVIDER=mock
LLM_MODEL=mock-model-v1
LLM_MAX_TOKENS=1000

# Only needed when LLM_ENABLED=true and LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Only needed when LLM_ENABLED=true and LLM_PROVIDER=gemini (the booking
# agent calls Gemini through Google AI Studio's free-tier API — no GCP
# billing account required). Get a key at aistudio.google.com/apikey.
# GEMINI_API_KEY=...

# Only needed when LLM_ENABLED=true and LLM_PROVIDER=huggingface (the
# booking agent calls Hugging Face's free serverless Inference API — no
# Google billing involved at all). Get a token at huggingface.co/settings/tokens.
# HF_API_TOKEN=hf_...
# HF_MODEL=google/gemma-3-4b-it
