# Database (SQLite by default; swap to a PostgreSQL URL for production)
DATABASE_URL=sqlite:///./data/outdoor_hounds.db

# LLM controls — defaults keep the app free and deterministic (mock mode)
LLM_ENABLED=false
LLM_PROVIDER=mock
LLM_MODEL=mock-model-v1
LLM_MAX_TOKENS=1000

# Only needed when LLM_ENABLED=true and LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
